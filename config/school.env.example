# Image tag must identify an exact build; do not use latest.
SCHOOLBASE_IMAGE=ghcr.io/replace-with-owner/schoolbase:replace-with-immutable-tag

# School identity and public URLs
APP_SLUG=demo
APP_NAME=SchoolBase
SCHOOL_NAME="SchoolBase Demo"
FRONTEND_URL=https://demo.schoolbase.africa
API_PUBLIC_URL=https://api.demo.schoolbase.africa
SUPERADMIN_LOGIN_URL=https://demo.schoolbase.africa/super-admin/login
CORS_ORIGINS=https://demo.schoolbase.africa

# Isolated database credentials
DB_NAME=sb_demo
DB_USER=sb_demo_app
DB_PASS=replace-with-a-generated-secret

# Isolated MinIO credentials and bucket
MINIO_BUCKET_NAME=demo
MINIO_ACCESS_KEY=sb_demo_app
MINIO_SECRET_KEY=replace-with-a-generated-secret
MINIO_PUBLIC_URL=https://files.schoolbase.africa
# Current uploads are browser-visible images, so anonymous reads are required.
MINIO_BUCKET_PUBLIC_READ=true

# Per-school application secrets
JWT_SECRET=replace-with-a-generated-secret
JWT_REFRESH_SECRET=replace-with-a-different-generated-secret
UPLOAD_KEY=replace-with-a-generated-secret
HASH_SALT=12

# Optional school branding and integrations
SCHOOL_LOGO_URL=
LOGO_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SchoolBase"
PAYSTACK_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-container limits; tune to the server's capacity.
APP_MEMORY_LIMIT=1g
APP_CPU_LIMIT=1.0
APP_PIDS_LIMIT=300
