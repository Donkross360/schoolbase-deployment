# Enter real secrets directly in Coolify. Do not commit a populated copy.
POSTGRES_ADMIN_USER=schoolbase_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-generated-secret
MINIO_ROOT_USER=schoolbase_minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-generated-secret

# Per-school credentials used by the Coolify provisioning tasks.
DEMO_DB_USER=sb_demo_app
DEMO_DB_PASSWORD=replace-with-a-different-generated-secret
STPAUL_DB_USER=sb_stpaul_app
STPAUL_DB_PASSWORD=replace-with-a-different-generated-secret
DEMO_MINIO_ACCESS_KEY=sb_demo_app
DEMO_MINIO_SECRET_KEY=replace-with-a-different-generated-secret
STPAUL_MINIO_ACCESS_KEY=sb_stpaul_app
STPAUL_MINIO_SECRET_KEY=replace-with-a-different-generated-secret
MINIO_BUCKET_PUBLIC_READ=true
RESTORE_MINIO_ACCESS_KEY=schoolbase_restore
RESTORE_MINIO_SECRET_KEY=replace-with-a-different-generated-secret

# Tune after checking the server's available CPU and memory.
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=1.5
MINIO_MEMORY_LIMIT=1g
MINIO_CPU_LIMIT=1.0
